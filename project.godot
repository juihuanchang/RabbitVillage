; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MyGame"
run/main_scene="res://scenes  場景/home/HomePage.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[autoload]

MCPRuntime="*uid://bp152yxptwqio"

[display]

window/size/viewport_width=1920.0
window/size/viewport_height=1080.0
window/size/window_width_override=1920.0
window/size/window_height_override=1080.0
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="MyGame"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
